<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>یاری ئۆکە</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  min-height:100vh;
  font-family:Arial,sans-serif;
  background:linear-gradient(135deg,#111827,#064e3b);
  color:white;
  overflow:hidden;
}

#game{
  width:100%;
  height:100vh;
  position:relative;
  display:flex;
  justify-content:center;
  align-items:center;
}

/* مێز */
.table{
  width:min(92vw,650px);
  height:min(72vh,520px);
  background:
    radial-gradient(circle at center,#15803d,#064e3b 70%);
  border:14px solid #78350f;
  border-radius:35px;
  box-shadow:
    0 20px 50px #000,
    inset 0 0 30px #022c22;
  position:relative;
}

/* کورسییەکان */
.player{
  position:absolute;
  background:#111827;
  border:2px solid #fbbf24;
  padding:7px 12px;
  border-radius:12px;
  font-size:14px;
  box-shadow:0 4px 10px #0008;
}

.p1{
  bottom:-55px;
  left:50%;
  transform:translateX(-50%);
}

.p2{
  top:50%;
  left:-65px;
  transform:translateY(-50%);
}

.p3{
  top:-55px;
  left:50%;
  transform:translateX(-50%);
}

.p4{
  top:50%;
  right:-65px;
  transform:translateY(-50%);
}

.active{
  background:#ca8a04;
  color:#fff;
}

/* ناوەڕاست */
.center{
  position:absolute;
  inset:20%;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
}

.info{
  background:#0008;
  padding:8px 16px;
  border-radius:20px;
  margin-bottom:10px;
  font-size:14px;
}

.discard{
  min-width:130px;
  min-height:80px;
  border:2px solid #fbbf24;
  border-radius:15px;
  background:#064e3b;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  padding:8px;
}

/* پارچە */
.tile{
  width:40px;
  height:58px;
  background:#f8fafc;
  color:#111827;
  border-radius:6px;
  margin:3px;
  border:2px solid #d1d5db;
  display:flex;
  justify-content:center;
  align-items:center;
  font-weight:bold;
  font-size:20px;
  box-shadow:0 3px 5px #0007;
  cursor:pointer;
  user-select:none;
}

.tile.red{
  color:#dc2626;
}

.tile.blue{
  color:#2563eb;
}

.tile.black{
  color:#111827;
}

.tile.yellow{
  color:#ca8a04;
}

.tile.selected{
  transform:translateY(-12px);
  border-color:#facc15;
  box-shadow:0 8px 12px #000;
}

/* دەستی یاریزان */
.hand{
  position:absolute;
  bottom:8px;
  left:50%;
  transform:translateX(-50%);
  width:95%;
  display:flex;
  justify-content:center;
  align-items:end;
  flex-wrap:wrap;
  max-height:125px;
  overflow:hidden;
}

/* دوگمەکان */
.controls{
  position:absolute;
  bottom:8px;
  right:8px;
  display:flex;
  gap:6px;
}

button{
  border:0;
  border-radius:10px;
  padding:9px 12px;
  background:#f59e0b;
  color:white;
  font-weight:bold;
  box-shadow:0 3px 8px #0008;
}

button:active{
  transform:scale(.95);
}

#message{
  position:absolute;
  top:10px;
  left:50%;
  transform:translateX(-50%);
  background:#000b;
  padding:8px 15px;
  border-radius:20px;
  font-size:14px;
  z-index:10;
}

/* مۆبایل */
@media(max-width:500px){

  .table{
    width:88vw;
    height:68vh;
    border-width:10px;
  }

  .tile{
    width:31px;
    height:45px;
    font-size:16px;
    margin:2px;
  }

  .player{
    font-size:12px;
    padding:5px 8px;
  }

  .p2{
    left:-48px;
  }

  .p4{
    right:-48px;
  }

  .p1,
  .p3{
    bottom:-45px;
  }

  .p3{
    top:-45px;
    bottom:auto;
  }

  .center{
    inset:25%;
  }
}
</style>
</head>

<body>

<div id="game">

  <div id="message">نۆرەی تۆیە 🎮</div>

  <div class="table">

    <div class="player p1 active">👤 تۆ</div>
    <div class="player p2">🤖 یاریزان ٢</div>
    <div class="player p3">🤖 یاریزان ٣</div>
    <div class="player p4">🤖 یاریزان ٤</div>

    <div class="center">

      <div class="info">
        پارچەی ماوە: <span id="remaining">106</span>
      </div>

      <div class="discard" id="discard">
        <div style="font-size:13px">پارچەی دەرخراو</div>
      </div>

    </div>

    <div class="hand" id="hand"></div>

    <div class="controls">
      <button onclick="drawTile()">🎴 هەڵگرتن</button>
      <button onclick="discardTile()">⬇️ دانان</button>
      <button onclick="sortTiles()">🔢 ڕێکخستن</button>
    </div>

  </div>

</div>

<script>

/* =========================
   دروستکردنی پارچەکانی ئۆکە
========================= */

const colors = [
  {name:"سوور", cls:"red"},
  {name:"شین", cls:"blue"},
  {name:"ڕەش", cls:"black"},
  {name:"زەرد", cls:"yellow"}
];

let tiles = [];

/* 1 تا 13 ــ دوو جار بۆ هەر ڕەنگ */
for(let round=0; round<2; round++){

  for(let c=0;c<colors.length;c++){

    for(let n=1;n<=13;n++){

      tiles.push({
        number:n,
        color:colors[c].name,
        cls:colors[c].cls
      });

    }

  }
}

/* پارچەکانی ساختە */
tiles.push({
  number:"★",
  color:"جوکر",
  cls:"red",
  joker:true
});

tiles.push({
  number:"★",
  color:"جوکر",
  cls:"blue",
  joker:true
});

/* شێڵکردن */
function shuffle(array){

  for(let i=array.length-1;i>0;i--){

    const j=Math.floor(Math.random()*(i+1));

    [array[i],array[j]]=[array[j],array[i]];

  }

}

/* =========================
   دەستی تۆ
========================= */

let myHand=[];

/* 14 پارچە بۆ تۆ */
for(let i=0;i<14;i++){

  myHand.push(tiles.pop());

}

renderHand();

/* =========================
   پیشاندانی پارچەکان
========================= */

function renderHand(){

  const hand=document.getElementById("hand");

  hand.innerHTML="";

  myHand.forEach((tile,index)=>{

    const div=document.createElement("div");

    div.className="tile "+tile.cls;

    div.textContent=tile.number;

    div.onclick=()=>selectTile(index);

    if(tile.selected){
      div.classList.add("selected");
    }

    hand.appendChild(div);

  });

}

/* =========================
   هەڵبژاردنی پارچە
========================= */

let selectedIndex=null;

function selectTile(index){

  myHand.forEach(t=>t.selected=false);

  myHand[index].selected=true;

  selectedIndex=index;

  renderHand();

  document.getElementById("message").textContent=
    "پارچەکەت هەڵبژێردرا 🀄";

}

/* =========================
   هەڵگرتنی پارچە
========================= */

function drawTile(){

  if(tiles.length===0){

    document.getElementById("message").textContent=
      "هیچ پارچەیەک نەماوە!";

    return;
  }

  const tile=tiles.pop();

  myHand.push(tile);

  document.getElementById("remaining").textContent=tiles.length;

  renderHand();

  document.getElementById("message").textContent=
    "پارچەیەکت هەڵگرت 🎴";

}

/* =========================
   دانانی پارچە
========================= */

function discardTile(){

  if(selectedIndex===null){

    document.getElementById("message").textContent=
      "سەرەتا پارچەیەک هەڵبژێرە!";

    return;
  }

  const tile=myHand.splice(selectedIndex,1)[0];

  tile.selected=false;

  selectedIndex=null;

  const discard=document.getElementById("discard");

  const div=document.createElement("div");

  div.className="tile "+tile.cls;

  div.textContent=tile.number;

  discard.appendChild(div);

  renderHand();

  document.getElementById("message").textContent=
    "پارچەکەت دانا؛ نۆرەی یاریزانەکانی ترە 🤖";

  setTimeout(()=>{

    computerTurn();

  },800);

}

/* =========================
   نۆرەی کۆمپیوتەر
========================= */

function computerTurn(){

  if(tiles.length>0){

    tiles.pop();

  }

  if(tiles.length>0){

    const randomIndex=Math.floor(Math.random()*tiles.length);

    tiles.splice(randomIndex,1);

  }

  document.getElementById("remaining").textContent=tiles.length;

  document.getElementById("message").textContent=
    "ئێستا نۆرەی تۆیە 🎮";

}

/* =========================
   ڕێکخستنی پارچەکان
========================= */

function sortTiles(){

  myHand.sort((a,b)=>{

    if(a.color===b.color){

      if(a.joker) return 1;

      if(b.joker) return -1;

      return a.number-b.number;

    }

    return a.color.localeCompare(b.color);

  });

  selectedIndex=null;

  myHand.forEach(t=>t.selected=false);

  renderHand();

  document.getElementById("message").textContent=
    "پارچەکان ڕێکخران 🔢";

}

/* =========================
   شێڵکردنی پارچەکان
========================= */

shuffle(tiles);

</script>

</body>
</html>
